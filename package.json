{
  "name": "harness-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Felan agent evaluations and benchmarks powered by harness-evals.",
  "scripts": {
    "list": "bun node_modules/harness-evals/dist/cli.js list",
    "run": "bun node_modules/harness-evals/dist/cli.js run",
    "analyze:output-style": "bun scripts/analyze-output-style.ts",
    "test:output-style": "bun test scripts/analyze-output-style.test.ts",
    "build:storzy-runtime": "docker build -f evals/runtimes/storzy/Dockerfile -t harness-bench-storzy-runtime:v1 .",
    "smoke": "bun node_modules/harness-evals/dist/cli.js run --case felan-adapter-smoke",
    "view": "bun node_modules/harness-evals/dist/cli.js view --latest --open"
  },
  "dependencies": {
    "harness-evals": "^0.2.6"
  }
}
