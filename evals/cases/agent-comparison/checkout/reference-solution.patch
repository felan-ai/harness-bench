diff --git a/lib/auth-session.ts b/lib/auth-session.ts
new file mode 100644
index 0000000..87a4fb8
--- /dev/null
+++ b/lib/auth-session.ts
@@ -0,0 +1,13 @@
+export function storeAuthenticatedSession(user: string, token: string) {
+  window.localStorage.setItem("currentUser", user)
+  window.localStorage.setItem("authToken", token)
+}
+
+export function readAuthToken() {
+  return window.localStorage.getItem("authToken")
+}
+
+export function clearAuthenticatedSession() {
+  window.localStorage.removeItem("currentUser")
+  window.localStorage.removeItem("authToken")
+}
diff --git a/lib/order-receipt.ts b/lib/order-receipt.ts
new file mode 100644
index 0000000..65408ae
--- /dev/null
+++ b/lib/order-receipt.ts
@@ -0,0 +1,26 @@
+export const ORDER_RECEIPT_STORAGE_KEY = "lastOrder"
+
+export interface OrderReceipt {
+  id: string
+  customer: {
+    firstName: string
+    lastName: string
+  }
+  total: number
+}
+
+export function isOrderReceipt(value: unknown): value is OrderReceipt {
+  if (typeof value !== "object" || value === null) return false
+
+  const order = value as Record<string, unknown>
+  if (typeof order.customer !== "object" || order.customer === null) return false
+
+  const customer = order.customer as Record<string, unknown>
+  return (
+    typeof order.id === "string" &&
+    typeof order.total === "number" &&
+    Number.isFinite(order.total) &&
+    typeof customer.firstName === "string" &&
+    typeof customer.lastName === "string"
+  )
+}
